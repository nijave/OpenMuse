# OpenMuse capture environment for the quadlet (mode 0600 on the host).
# KEY=value, no quotes, no export.
MUSE_ADDRESS=00:00:00:00:00:00
MUSE_PRESET=p1035
MUSE_ROTATE_AT=12:00

# Optional: publish the capture to Home Assistant via MQTT discovery
# (empty MUSE_MQTT_HOST disables MQTT).
#MUSE_MQTT_HOST=
#MUSE_MQTT_PORT=1883
#MUSE_MQTT_USER=
#MUSE_MQTT_PASSWORD=
#MUSE_MQTT_PREFIX=openmuse
#MUSE_HA_DISCOVERY_PREFIX=homeassistant
#MUSE_MQTT_INTERVAL=10
